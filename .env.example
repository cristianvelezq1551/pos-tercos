# Postgres local (docker-compose)
DATABASE_URL=postgresql://pos:pos_dev@localhost:5432/pos_tercos_dev?schema=public

# JWT
JWT_ACCESS_SECRET=change-me-in-prod-access
JWT_REFRESH_SECRET=change-me-in-prod-refresh
# Token HMAC de pedidos web (en dev cae a JWT_ACCESS_SECRET; en prod OBLIGATORIA)
WEB_ORDER_TOKEN_SECRET=

# API
API_PORT=3001
API_HOST=0.0.0.0

# CORS (dev: allow all next.js apps). En prod OBLIGATORIA (crash al boot sin ella).
CORS_ORIGINS=http://localhost:3000,http://localhost:3002,http://localhost:3003,http://localhost:3004,http://localhost:3005,http://localhost:3006

# Anthropic (IA facturas + auto-pedido) — primary
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5

# OpenAI (fallback IA) — opcional
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# LLM provider preference: 'anthropic' | 'openai'
# Si solo hay una key configurada, esa se usa sin importar este valor.
LLM_PROVIDER=anthropic

# Storage adapter (en dev: 'local', en prod: 'r2' + R2_*). En prod OBLIGATORIA.
STORAGE_PROVIDER=local
STORAGE_LOCAL_PATH=./tmp/uploads
# R2_ENDPOINT=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=
# R2_PUBLIC_URL_BASE=

# WhatsApp — sin vars = MockWhatsAppAdapter (dev, solo loggea).
# Producción: KAPSO (Cloud API oficial, ver kapso-setup.md). Todo-o-nada.
# KAPSO_API_KEY=
# KAPSO_PHONE_NUMBER_ID=
# WHATSAPP_TEMPLATES_ENABLED=true   # recién con los 5 templates aprobados
# WHATSAPP_TEMPLATE_LANG=es
# Legacy OpenWA (no usar en prod nueva):
# OPENWA_URL=
# OPENWA_API_KEY=
# OPENWA_SESSION_ID=

# Dueño (alertas antifraude + digest diario 21:30). Sin ella no se envían.
OWNER_WHATSAPP_PHONE=

# Negocio (mensajes WhatsApp + recibos)
BUSINESS_NAME=Tercos
BUSINESS_ADDRESS=
BUSINESS_ADDRESS_SHORT=
BUSINESS_NIT=
BUSINESS_PHONE=

# Instrucciones de pago (mensaje al crear pedido web)
PAYMENT_INSTRUCTIONS_NEQUI=
PAYMENT_INSTRUCTIONS_TRANSFER=

# Impresión (en dev: 'local' = dump a ./tmp/receipts; en prod: 'escpos')
PRINTER_PROVIDER=local
# PRINT_AGENT_URL=http://localhost:9120
# PRINT_AGENT_SECRET=
# RECEIPTS_LOCAL_PATH=./tmp/receipts
