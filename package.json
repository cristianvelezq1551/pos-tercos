{
  "name": "pos-tercos",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@10.33.2",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "node scripts/assert-no-dev-server.mjs && turbo run build",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "format": "prettier --write \"**/*.{ts,tsx,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,json,md}\"",
    "test:cov": "turbo run test:cov",
    "dev:reset": "node scripts/kill-dev.mjs && pnpm dev",
    "kill": "node scripts/kill-dev.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "@vitest/coverage-v8": "^3.2.7",
    "eslint": "^9.18.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^15.14.0",
    "prettier": "^3.4.2",
    "turbo": "^2.10.0",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.21.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@nestjs/core",
      "@prisma/client",
      "@prisma/engines",
      "bcrypt",
      "prisma",
      "sharp",
      "unrs-resolver",
      "usb"
    ],
    "//overrides": "Fuerza versiones parcheadas de deps TRANSITIVAS con CVE (no podemos esperar a que el padre actualice). Reglas: (1) el rango va POR MAJOR y el reemplazo se ancla con caret -- un \">=\" suelto deja que la resolucion salte de major y minimatch@3 termina con brace-expansion 5.x, que tiene otra API; (2) `pnpm audit --prod` (servidor) debe dar CERO. Queda a proposito 1 aviso LOW de esbuild (lectura de archivos del dev server de vite EN WINDOWS, y aca se trabaja en macOS): forzarlo arrastraba vite 8 -- un major -- a la cadena de tests y dejaba el arbol con tres esbuild.",
    "overrides": {
      "tar@<7.5.19": ">=7.5.19",
      "ws@<8.21.0": ">=8.21.0",
      "form-data@<4.0.6": ">=4.0.6",
      "qs@<6.15.2": ">=6.15.2",
      "multer@<2.2.0": ">=2.2.0",
      "@babel/core@<7.29.6": ">=7.29.6",
      "deepmerge-ts@<8.0.0": ">=8.0.0",
      "body-parser@<2.3.0": ">=2.3.0",
      "sharp@<0.35.0": ">=0.35.0",
      "postcss@<8.5.18": ">=8.5.18",
      "brace-expansion@<2": "^1.1.18",
      "brace-expansion@>=2 <3": "^2.1.4",
      "brace-expansion@>=4": "^5.0.9",
      "js-yaml@<4": "^3.15.1",
      "js-yaml@>=4 <5": "^4.3.1",
      "fast-uri@>=3 <4": "^3.1.5"
    }
  }
}
