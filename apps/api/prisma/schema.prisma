generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                 String                  @id @default(uuid())
  email              String                  @unique
  passwordHash       String                  @map("password_hash")
  fullName           String                  @map("full_name")
  phone              String?
  role               UserRole
  mustChangePwd      Boolean                 @default(true) @map("must_change_pwd")
  tokenVersion       Int                     @default(0) @map("token_version")
  active             Boolean                 @default(true)
  /// Datos de empleo (RRHH). payType = MENSUAL (salario/mes) o DIARIO (valor/día).
  /// salaryAmount = salario mensual o valor por día según payType. La paga es
  /// SIEMPRE SEMANAL (lunes a domingo). terminationDate = fin del trabajo (null
  /// = activo). restDaysOfWeek = días de descanso cíclicos (0=domingo … 6=sábado);
  /// solo afecta a DAILY: esos días NO se pagan ni cuentan como trabajados.
  hireDate           DateTime?               @map("hire_date")
  payType            PayType?                @map("pay_type")
  salaryAmount       Decimal?                @map("salary_amount") @db.Decimal(12, 2)
  terminationDate    DateTime?               @map("termination_date")
  restDaysOfWeek     Int[]                   @default([]) @map("rest_days_of_week")
  createdAt          DateTime                @default(now()) @map("created_at")
  approvalPin        ApprovalPin?
  auditLogs          AuditLog[]
  cashMovements      CashMovement[]
  idempotencyKeys    IdempotencyKey[]
  inventoryMovements InventoryMovement[]
  stockCounts        StockCount[]
  invoicesConfirmed  Invoice[]               @relation("InvoiceConfirmedBy")
  invoicesPaid       Invoice[]               @relation("InvoicePaymentActor")
  invoicesUploaded   Invoice[]               @relation("InvoiceUploadedBy")
  promotionsCreated  Promotion[]
  purchaseSuggestionsResolved PurchaseSuggestion[]
  refreshTokens      RefreshToken[]
  saleStatusChanges  SaleStatusLog[]
  salesAsCashier     Sale[]                  @relation("SaleCashier")
  salesAsPaidBy      Sale[]                  @relation("SalePaidBy")
  shifts             Shift[]
  paymentReconciliations PaymentReconciliation[]
  payrollDays        PayrollDay[]
  payrollAdjustments PayrollAdjustment[]
  payrollPayments    PayrollPayment[]
  payrollWeekPayments PayrollWeekPayment[]
  fixedCostPayments  FixedCostPayment[]      @relation("FixedCostPaymentActor")

  @@index([role, active])
  @@map("users")
}

model RefreshToken {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

model Product {
  id                    String              @id @default(uuid())
  name                  String
  description           String?
  /// Paso a paso de preparación (la "biblia" del cocinero). Ordenado. Editable
  /// desde el admin; lo lee el KDS por GET /recipe-book.
  preparationSteps      String[]            @default([]) @map("preparation_steps")
  basePrice             Decimal             @map("base_price") @db.Decimal(12, 2)
  category              String?
  imageUrl              String?             @map("image_url")
  modifiersEnabled      Boolean             @default(false) @map("modifiers_enabled")
  isCombo               Boolean             @default(false) @map("is_combo")
  comboPrice            Decimal?            @map("combo_price") @db.Decimal(12, 2)
  isActive              Boolean             @default(true) @map("is_active")
  /// "86" manual: el cajero/admin lo marca agotado y desaparece como vendible
  /// (cajero + web) sin tocar el catálogo. Independiente del stock de insumos.
  soldOut               Boolean             @default(false) @map("sold_out")
  createdAt             DateTime            @default(now()) @map("created_at")
  updatedAt             DateTime            @updatedAt @map("updated_at")
  conversionFactor      Decimal?            @map("conversion_factor") @db.Decimal(14, 6)
  directResale          Boolean             @default(false) @map("direct_resale")
  thresholdMin          Decimal             @default(0) @map("threshold_min") @db.Decimal(14, 4)
  unitPurchase          String?             @map("unit_purchase")
  unitStock             String?             @map("unit_stock")
  lastUnitCost          Decimal?            @map("last_unit_cost") @db.Decimal(14, 4)
  lastUnitCostDate      DateTime?           @map("last_unit_cost_date")
  comboComponents       ComboComponent[]    @relation("ComboParent")
  partOfCombos          ComboComponent[]    @relation("ComboChild")
  movements             InventoryMovement[]
  invoiceItems          InvoiceItem[]
  stockCounts           StockCount[]
  modifiers             ProductModifier[]
  sizes                 ProductSize[]
  promotionProducts     PromotionProduct[]
  purchaseSuggestions   PurchaseSuggestion[]
  recipeEdges           RecipeEdge[]        @relation("ProductRecipe")
  saleItems             SaleItem[]
  supplierResaleHistory SupplierProduct[]   @relation("SupplierProductResale")

  @@index([category, isActive])
  @@index([isActive])
  @@index([directResale, isActive])
  @@map("products")
}

model ProductSize {
  id            String       @id @default(uuid())
  productId     String       @map("product_id")
  name          String
  priceModifier Decimal      @default(0) @map("price_modifier") @db.Decimal(12, 2)
  sortOrder     Int          @default(0) @map("sort_order")
  product       Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  saleItems     SaleItem[]
  /// Receta propia de la variante (aditiva sobre la receta base del producto).
  /// Ej. la proteína: "Carne" descuenta carne, "Pollo" descuenta pollo.
  recipeEdges   RecipeEdge[] @relation("SizeRecipe")

  @@index([productId])
  @@map("product_sizes")
}

model ProductModifier {
  id          String  @id @default(uuid())
  productId   String  @map("product_id")
  name        String
  priceDelta  Decimal @default(0) @map("price_delta") @db.Decimal(12, 2)
  recipeDelta Json    @default("{}") @map("recipe_delta")
  product     Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@map("product_modifiers")
}

model ComboComponent {
  id        String  @id @default(uuid())
  comboId   String  @map("combo_id")
  productId String  @map("product_id")
  quantity  Int     @default(1)
  combo     Product @relation("ComboParent", fields: [comboId], references: [id], onDelete: Cascade)
  product   Product @relation("ComboChild", fields: [productId], references: [id])

  @@index([comboId])
  @@index([productId])
  @@map("combo_components")
}

model Subproduct {
  id                  String              @id @default(uuid())
  name                String
  yield               Decimal             @db.Decimal(10, 4)
  unit                String              @default("unidad")
  /// Paso a paso de preparación (biblia del cocinero). Ordenado.
  preparationSteps    String[]            @default([]) @map("preparation_steps")
  /// Umbral mínimo de stock (en `unit`). Si stock cae bajo este nivel
  /// debería sugerirse producir más. 0 = sin umbral.
  thresholdMin        Decimal             @default(0) @db.Decimal(14, 4) @map("threshold_min")
  /// Tamaño de una porción, en `unit`. Null = sin porción definida.
  portionSize         Decimal?            @db.Decimal(14, 4) @map("portion_size")
  isActive            Boolean             @default(true) @map("is_active")
  createdAt           DateTime            @default(now()) @map("created_at")
  updatedAt           DateTime            @updatedAt @map("updated_at")
  consumedAs          RecipeEdge[]        @relation("SubproductChild")
  recipeEdges         RecipeEdge[]        @relation("SubproductRecipe")
  inventoryMovements  InventoryMovement[]
  stockCounts         StockCount[]

  @@index([isActive])
  @@map("subproducts")
}

model Ingredient {
  id               String              @id @default(uuid())
  name             String
  unitPurchase     String              @map("unit_purchase")
  unitRecipe       String              @map("unit_recipe")
  conversionFactor Decimal             @map("conversion_factor") @db.Decimal(14, 6)
  thresholdMin     Decimal             @default(0) @map("threshold_min") @db.Decimal(14, 4)
  /// Tamaño de una porción, en unitRecipe (ej. 150 = 150 g/porción). Null = sin porción.
  portionSize      Decimal?            @map("portion_size") @db.Decimal(14, 4)
  /// Costo histórico (FASE 4 ajustes 2.2). En unitPurchase. Auto-actualizado al confirmar facturas.
  lastUnitCost     Decimal?            @map("last_unit_cost") @db.Decimal(14, 4)
  lastUnitCostDate DateTime?           @map("last_unit_cost_date")
  isActive         Boolean             @default(true) @map("is_active")
  createdAt        DateTime            @default(now()) @map("created_at")
  updatedAt        DateTime            @updatedAt @map("updated_at")
  movements        InventoryMovement[]
  invoiceItems     InvoiceItem[]
  stockCounts      StockCount[]
  consumedAs       RecipeEdge[]        @relation("IngredientChild")
  purchaseSuggestions PurchaseSuggestion[]
  supplierProducts SupplierProduct[]

  @@index([isActive])
  @@map("ingredients")
}

model RecipeEdge {
  id                 String       @id @default(uuid())
  parentProductId    String?      @map("parent_product_id")
  parentSubproductId String?      @map("parent_subproduct_id")
  parentSizeId       String?      @map("parent_size_id")
  childIngredientId  String?      @map("child_ingredient_id")
  childSubproductId  String?      @map("child_subproduct_id")
  quantityNeta       Decimal      @map("quantity_neta") @db.Decimal(14, 4)
  mermaPct           Decimal      @default(0) @map("merma_pct") @db.Decimal(5, 4)
  createdAt          DateTime     @default(now()) @map("created_at")
  childIngredient    Ingredient?  @relation("IngredientChild", fields: [childIngredientId], references: [id], onDelete: Restrict)
  childSubproduct    Subproduct?  @relation("SubproductChild", fields: [childSubproductId], references: [id], onDelete: Restrict)
  parentProduct      Product?     @relation("ProductRecipe", fields: [parentProductId], references: [id], onDelete: Cascade)
  parentSubproduct   Subproduct?  @relation("SubproductRecipe", fields: [parentSubproductId], references: [id], onDelete: Cascade)
  parentSize         ProductSize? @relation("SizeRecipe", fields: [parentSizeId], references: [id], onDelete: Cascade)

  @@index([parentProductId])
  @@index([parentSubproductId])
  @@index([parentSizeId])
  @@index([childIngredientId])
  @@index([childSubproductId])
  @@map("recipe_edges")
}

model InventoryMovement {
  id             String                @id @default(uuid())
  ingredientId   String?               @map("ingredient_id")
  delta          Decimal               @db.Decimal(14, 4)
  type           InventoryMovementType
  /// Costo por unidad de stock/receta. Solo entradas (delta > 0: PURCHASE,
  /// INITIAL, ajuste+). NULL en consumos (el costo lo resuelve el motor FIFO)
  /// y en entradas sin costo conocido. Base del costeo real (COGS).
  unitCost       Decimal?              @db.Decimal(14, 4) @map("unit_cost")
  sourceType     String?               @map("source_type")
  sourceId       String?               @map("source_id")
  userId         String?               @map("user_id")
  notes          String?
  /// Foto de evidencia (#6). Storage key de la foto que sube el cocinero al
  /// registrar una producción. Se guarda en el movement +N de la tanda.
  evidenceKey    String?               @map("evidence_key")
  idempotencyKey String?               @unique @map("idempotency_key")
  createdAt      DateTime              @default(now()) @map("created_at")
  entityType     StockableType         @map("entity_type")
  productId      String?               @map("product_id")
  subproductId   String?               @map("subproduct_id")
  ingredient     Ingredient?           @relation(fields: [ingredientId], references: [id], onDelete: Restrict)
  product        Product?              @relation(fields: [productId], references: [id], onDelete: Restrict)
  subproduct     Subproduct?           @relation(fields: [subproductId], references: [id], onDelete: Restrict)
  user           User?                 @relation(fields: [userId], references: [id])

  @@index([ingredientId, createdAt(sort: Desc)])
  @@index([productId, createdAt(sort: Desc)])
  @@index([subproductId, createdAt(sort: Desc)])
  @@index([entityType, createdAt(sort: Desc)])
  @@index([type, createdAt(sort: Desc)])
  @@map("inventory_movements")
}

/// Insert-only audit trail for sensitive actions.
/// `action` is a free-form string validated against AuditActionEnum
/// in @pos-tercos/types (string column for forward-compat without
/// requiring DB migrations to add new actions).
model AuditLog {
  id         String   @id @default(uuid())
  userId     String?  @map("user_id")
  action     String
  entityType String?  @map("entity_type")
  entityId   String?  @map("entity_id")
  beforeJson Json?    @map("before_json")
  afterJson  Json?    @map("after_json")
  metadata   Json?
  createdAt  DateTime @default(now()) @map("created_at")
  user       User?    @relation(fields: [userId], references: [id])

  @@index([userId, createdAt(sort: Desc)])
  @@index([action, createdAt(sort: Desc)])
  @@index([entityType, entityId, createdAt(sort: Desc)])
  @@map("audit_log")
}

model Supplier {
  id        String            @id @default(uuid())
  nit       String            @unique
  name      String
  phone     String?
  email     String?
  notes     String?
  isActive  Boolean           @default(true) @map("is_active")
  createdAt DateTime          @default(now()) @map("created_at")
  updatedAt DateTime          @updatedAt @map("updated_at")
  invoices  Invoice[]
  products  SupplierProduct[]

  @@index([isActive])
  @@map("suppliers")
}

/// Catálogo histórico de costos por (proveedor, item). Polimórfico igual
/// que inventory_movements: el item asociado puede ser un Insumo o un
/// Producto direct-resale.
///
/// `last_unit_price` está en la unidad de COMPRA del item (kg, caja,
/// pack-12). Para obtener costo por unidad de stock, dividir por
/// conversion_factor del item.
model SupplierProduct {
  id               String        @id @default(uuid())
  supplierId       String        @map("supplier_id")
  ingredientId     String?       @map("ingredient_id")
  lastUnitPrice    Decimal?      @map("last_unit_price") @db.Decimal(14, 4)
  lastPurchaseDate DateTime?     @map("last_purchase_date")
  createdAt        DateTime      @default(now()) @map("created_at")
  updatedAt        DateTime      @updatedAt @map("updated_at")
  entityType       StockableType @map("entity_type")
  productId        String?       @map("product_id")
  ingredient       Ingredient?   @relation(fields: [ingredientId], references: [id], onDelete: Cascade)
  product          Product?      @relation("SupplierProductResale", fields: [productId], references: [id], onDelete: Cascade)
  supplier         Supplier      @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  @@unique([supplierId, ingredientId])
  @@unique([supplierId, productId])
  @@index([supplierId])
  @@index([ingredientId])
  @@index([productId])
  @@map("supplier_products")
}

model Invoice {
  id               String        @id @default(uuid())
  supplierId       String?       @map("supplier_id")
  invoiceNumber    String?       @map("invoice_number")
  total            Decimal?      @db.Decimal(14, 2)
  iva              Decimal?      @db.Decimal(14, 2)
  photoStorageKey  String?       @map("photo_storage_key")
  aiExtractionJson Json?         @map("ai_extraction_json")
  aiModelUsed      String?       @map("ai_model_used")
  status           InvoiceStatus @default(PENDING_REVIEW)
  uploadedById     String?       @map("uploaded_by_id")
  confirmedById    String?       @map("confirmed_by_id")
  confirmedAt      DateTime?     @map("confirmed_at")
  notes            String?
  /// Control de pago al proveedor (independiente de `status` que es solo
  /// sobre la validación IA). NULL = aún no aplicable (factura sin confirmar);
  /// 'PENDING' = confirmada pero no transferida; 'PAID' = ya pagada con
  /// comprobante. Solo Dueño + PIN. CHECK al nivel DB.
  paymentStatus    String?       @map("payment_status")
  paidAt           DateTime?     @map("paid_at")
  /// Storage key de la foto del comprobante de transferencia. Obligatorio
  /// si paymentStatus='PAID'.
  paymentProofKey  String?       @map("payment_proof_key")
  paymentActorId   String?       @map("payment_actor_id")
  paymentNote      String?       @map("payment_note")
  /// Bolsillo de tesorería del que salió el pago: 'EFECTIVO' | 'CUENTA'.
  /// (legacy; hoy el reparto real vive en payment_cash_amount/bank_amount).
  paymentPocket    String        @default("CUENTA") @map("payment_pocket")
  /// Reparto del pago por bolsillo (permite mixto). Suman el total.
  paymentCashAmount Decimal      @default(0) @map("payment_cash_amount") @db.Decimal(14, 2)
  paymentBankAmount Decimal      @default(0) @map("payment_bank_amount") @db.Decimal(14, 2)
  /// Responsable que asume este gasto (ej. Cristian / Pablo) — para el
  /// desglose de compromisos en Tesorería. NULL = sin asignar.
  responsible      String?
  createdAt        DateTime      @default(now()) @map("created_at")
  updatedAt        DateTime      @updatedAt @map("updated_at")
  items            InvoiceItem[]
  confirmedBy      User?         @relation("InvoiceConfirmedBy", fields: [confirmedById], references: [id])
  paymentActor     User?         @relation("InvoicePaymentActor", fields: [paymentActorId], references: [id])
  supplier         Supplier?     @relation(fields: [supplierId], references: [id])
  uploadedBy       User?         @relation("InvoiceUploadedBy", fields: [uploadedById], references: [id])

  @@index([status, createdAt(sort: Desc)])
  @@index([supplierId, createdAt(sort: Desc)])
  @@index([paymentStatus, createdAt(sort: Desc)])
  @@map("invoices")
}

model InvoiceItem {
  id             String         @id @default(uuid())
  invoiceId      String         @map("invoice_id")
  ingredientId   String?        @map("ingredient_id")
  descriptionRaw String         @map("description_raw")
  quantity       Decimal        @db.Decimal(14, 4)
  unit           String
  unitPrice      Decimal        @map("unit_price") @db.Decimal(14, 4)
  total          Decimal        @db.Decimal(14, 2)
  sortOrder      Int            @default(0) @map("sort_order")
  entityType     StockableType? @map("entity_type")
  productId      String?        @map("product_id")
  ingredient     Ingredient?    @relation(fields: [ingredientId], references: [id])
  invoice        Invoice        @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  product        Product?       @relation(fields: [productId], references: [id])

  @@index([invoiceId])
  @@index([ingredientId])
  @@index([productId])
  @@map("invoice_items")
}

/// Header de venta. Solo COUNTER (mostrador) y WEB_PICKUP (recoger en local).
///
/// receipt_number usa la sequence `receipt_seq` (creada en la migración
/// 20260427220551). El default se declara con dbgenerated para que el
/// schema NO drifte a IDENTITY/autoincrement: un `migrate dev` desde cero
/// debe conservar la sequence (SalesService pide nextval('receipt_seq')
/// explícito). La sequence garantiza monotonicidad incluso con rollback.
///
/// idempotency_key permite que el POS reintente POST /sales sin duplicar.
/// El campo es UNIQUE pero opcional (web orders no lo usan).
model Sale {
  id                            String          @id @default(uuid())
  receiptNumber                 BigInt          @unique @default(dbgenerated("nextval('receipt_seq'::regclass)")) @map("receipt_number")
  type                          SaleType
  status                        SaleStatus      @default(PENDIENTE_PAGO)
  /// Turno mostrado al cliente. Se asigna al PAGAR (no al crear): secuencia
  /// diaria única compartida entre COUNTER y WEB_PICKUP. Null hasta el pago.
  turnNumber                    Int?            @map("turn_number")
  customerName                  String?         @map("customer_name")
  customerPhone                 String?         @map("customer_phone")
  customerNit                   String?         @map("customer_nit")
  subtotal                      Decimal         @db.Decimal(14, 2)
  discountTotal                 Decimal         @default(0) @map("discount_total") @db.Decimal(14, 2)
  total                         Decimal         @db.Decimal(14, 2)
  /// Cuenta abierta (#3): venta COUNTER que vive en PENDIENTE_PAGO
  /// indefinidamente (cliente conocido). Exenta del sweep de abandonadas.
  isOpenTab                     Boolean         @default(false) @map("is_open_tab")
  /// Descuento manual (#5b): motivo obligatorio cuando hay descuento manual.
  discountReason                String?         @map("discount_reason")
  /// Descuento manual sobre el TOTAL: 'FIXED' | 'PERCENT' (CHECK en DB).
  orderDiscountKind             String?         @map("order_discount_kind")
  orderDiscountValue            Decimal?        @map("order_discount_value") @db.Decimal(14, 2)
  /// Monto resultante del descuento sobre el total (0 si no hay).
  /// discount_total = Σ line_discount + order_discount_amount.
  orderDiscountAmount           Decimal         @default(0) @map("order_discount_amount") @db.Decimal(14, 2)
  paymentMethod                 PaymentMethod?  @map("payment_method")
  paidAt                        DateTime?       @map("paid_at")
  /// Momento en que la cocina marcó LISTO_DESPACHO. Ordena la cola de
  /// "listos por llamar" del cajero. Null hasta que esté listo.
  readyAt                       DateTime?       @map("ready_at")
  /// Momento en que el cajero llamó este turno a la pantalla pública. Null
  /// mientras está listo pero aún sin llamar. Permite "ya llamado" + re-llamar.
  calledAt                      DateTime?       @map("called_at")
  paidByUserId                  String?         @map("paid_by_user_id")
  cashierId                     String?         @map("cashier_id")
  shiftId                       String?         @map("shift_id")
  notes                         String?
  /// Motivo de anulación (solo cuando status=VOID). Se muestra en el historial.
  voidReason                    String?         @map("void_reason")
  idempotencyKey                String?         @unique @map("idempotency_key")
  createdAt                     DateTime        @default(now()) @map("created_at")
  public_token                  String?         @unique
  notified_payment_instructions Boolean         @default(false)
  notified_payment_received     Boolean         @default(false)
  notified_ready_for_pickup     Boolean         @default(false)
  notified_canceled             Boolean         @default(false)
  items                         SaleItem[]
  statusLog                     SaleStatusLog[]
  payments                      SalePayment[]
  whatsappMessages              WhatsAppMessage[]
  cashier                       User?           @relation("SaleCashier", fields: [cashierId], references: [id])
  paidBy                        User?           @relation("SalePaidBy", fields: [paidByUserId], references: [id])
  shift                         Shift?          @relation(fields: [shiftId], references: [id])

  @@unique([shiftId, turnNumber])
  @@index([status, createdAt(sort: Desc)])
  @@index([cashierId, createdAt(sort: Desc)])
  @@index([type, status, createdAt(sort: Desc)])
  @@index([shiftId])
  @@index([status, readyAt])
  /// Reportes financieros (P&G, dashboard, COGS) filtran por rango de paidAt.
  @@index([paidAt])
  @@map("sales")
}

/// Línea de venta. unit_price está CONGELADO al momento de la venta —
/// no se actualiza si después cambia el basePrice del producto.
/// modifiers_json es snapshot (array de objetos con name/priceDelta) para
/// preservar la información tal como estaba al momento de la venta.
model SaleItem {
  id                 String       @id @default(uuid())
  saleId             String       @map("sale_id")
  productId          String       @map("product_id")
  sizeId             String?      @map("size_id")
  quantity           Int
  unitPrice          Decimal      @map("unit_price") @db.Decimal(12, 2)
  modifiersJson      Json         @default("[]") @map("modifiers_json")
  notes              String?
  appliedPromotionId String?      @map("applied_promotion_id")
  lineSubtotal       Decimal      @map("line_subtotal") @db.Decimal(14, 2)
  lineDiscount       Decimal      @default(0) @map("line_discount") @db.Decimal(14, 2)
  lineTotal          Decimal      @map("line_total") @db.Decimal(14, 2)
  /// Comanda incremental (#3): unidades de esta línea YA enviadas a cocina.
  /// La comanda de una cuenta abierta imprime quantity - sent_to_kitchen_qty.
  sentToKitchenQty   Int          @default(0) @map("sent_to_kitchen_qty")
  sentToKitchenAt    DateTime?    @map("sent_to_kitchen_at")
  /// Descuento manual por línea (#5b): 'FIXED' | 'PERCENT' (CHECK en DB).
  /// El monto resultante vive en line_discount (appliedPromotionId queda null).
  manualDiscountKind  String?     @map("manual_discount_kind")
  manualDiscountValue Decimal?    @map("manual_discount_value") @db.Decimal(14, 2)
  appliedPromotion   Promotion?   @relation(fields: [appliedPromotionId], references: [id])
  product            Product      @relation(fields: [productId], references: [id])
  sale               Sale         @relation(fields: [saleId], references: [id], onDelete: Cascade)
  size               ProductSize? @relation(fields: [sizeId], references: [id])

  @@index([saleId])
  @@index([productId])
  @@index([appliedPromotionId])
  @@map("sale_items")
}

/// Insert-only via trigger DB (igual que inventory_movements y audit_log).
/// Cada cambio de Sale.status agrega una fila con (from, to, user, notes).
/// Permite calcular tiempos por etapa para reportes (FASE 13).
model SaleStatusLog {
  id         String   @id @default(uuid())
  saleId     String   @map("sale_id")
  statusFrom String?  @map("status_from")
  statusTo   String   @map("status_to")
  userId     String?  @map("user_id")
  notes      String?
  changedAt  DateTime @default(now()) @map("changed_at")
  sale       Sale     @relation(fields: [saleId], references: [id], onDelete: Cascade)
  user       User?    @relation(fields: [userId], references: [id])

  @@index([saleId, changedAt])
  @@map("sale_status_log")
}

/// Turno de caja del cajero. FASE 5 cubre solo apertura (opening_cash).
/// expected_cash, counted_cash, difference, closed_at quedan NULL hasta
/// FASE 11 que implementa cierre + reconciliación.
///
/// CHECK: solo puede haber 1 Shift OPEN por cajero a la vez (validado en
/// service, no en DB porque requiere subquery).
model Shift {
  id           String      @id @default(uuid())
  cashierId    String      @map("cashier_id")
  openedAt     DateTime    @default(now()) @map("opened_at")
  closedAt     DateTime?   @map("closed_at")
  openingCash  Decimal     @map("opening_cash") @db.Decimal(14, 2)
  expectedCash Decimal?    @map("expected_cash") @db.Decimal(14, 2)
  countedCash  Decimal?    @map("counted_cash") @db.Decimal(14, 2)
  difference   Decimal?    @db.Decimal(14, 2)
  notes        String?
  /// Arqueo por denominación al cerrar (JSON [{denomination, count}]). Opcional.
  cashCountBreakdown Json?  @map("cash_count_breakdown")
  digitalCountBreakdown Json?     @map("digital_count_breakdown")
  /// Propinas del día (efectivo aparte de la caja; se reparten en nómina).
  tipsCollected Decimal? @map("tips_collected") @db.Decimal(14, 2)
  status       ShiftStatus @default(OPEN)
  sales        Sale[]
  cashMovements CashMovement[]
  cashier      User        @relation(fields: [cashierId], references: [id])

  @@index([cashierId, status])
  @@index([status, openedAt(sort: Desc)])
  @@map("shifts")
}

/// Entradas/salidas de efectivo del cajón durante el turno, aparte de ventas
/// (ej. fondo de cambio, pago a proveedor en efectivo, retiro). Ajustan el
/// efectivo esperado al cierre. Insert-only (no se editan; se compensan).
model CashMovement {
  id        String           @id @default(uuid())
  shiftId   String           @map("shift_id")
  type      CashMovementType
  /// CASH = cajón físico; digital = cuenta del negocio (arqueo digital).
  method PaymentMethod @default(CASH)
  amount    Decimal          @db.Decimal(14, 2)
  reason    String
  userId    String           @map("user_id")
  createdAt DateTime         @default(now()) @map("created_at")
  shift     Shift            @relation(fields: [shiftId], references: [id])
  user      User             @relation(fields: [userId], references: [id])

  @@index([shiftId, createdAt])
  @@map("cash_movements")
}

/// Promociones automáticas aplicadas en cobro. 4 tipos (FASE 12):
/// - PERCENT_OFF: discount_pct requerido.
/// - FIXED_OFF: discount_fixed requerido.
/// - BOGO: bogo_buy_qty + bogo_get_qty requeridos.
/// - COMBO_OFF: discount_pct o discount_fixed (al menos uno).
///
/// Resolución de overlap: para cada sale_item, buscar promociones activas
/// que matcheen day-of-week + hora + producto, aplicar la de mayor descuento
/// ABSOLUTO en COP. No acumulables.
///
/// daysOfWeekMask es bitmask: lunes=1, martes=2, miércoles=4, jueves=8,
/// viernes=16, sábado=32, domingo=64. 127 = todos los días.
model Promotion {
  id             String             @id @default(uuid())
  name           String
  type           PromotionType      @default(PERCENT_OFF)
  discountPct    Decimal?           @map("discount_pct") @db.Decimal(5, 4)
  discountFixed  Decimal?           @map("discount_fixed") @db.Decimal(10, 2)
  bogoBuyQty     Int?               @map("bogo_buy_qty")
  bogoGetQty     Int?               @map("bogo_get_qty")
  daysOfWeekMask Int                @map("days_of_week_mask")
  timeStart      String             @map("time_start")
  timeEnd        String             @map("time_end")
  activeFrom     DateTime?          @map("active_from") @db.Date
  activeTo       DateTime?          @map("active_to") @db.Date
  isActive       Boolean            @default(true) @map("is_active")
  createdById    String?            @map("created_by")
  createdAt      DateTime           @default(now()) @map("created_at")
  products       PromotionProduct[]
  createdBy      User?              @relation(fields: [createdById], references: [id])
  saleItems      SaleItem[]

  @@index([isActive])
  @@map("promotions")
}

model PromotionProduct {
  promotionId String    @map("promotion_id")
  productId   String    @map("product_id")
  product     Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  promotion   Promotion @relation(fields: [promotionId], references: [id], onDelete: Cascade)

  @@id([promotionId, productId])
  @@index([productId])
  @@map("promotion_products")
}

/// Cache de respuestas para POSTs idempotentes (sales, shifts/open, etc.).
/// Cuando el cliente envía Idempotency-Key, el backend busca acá; si la
/// key existe + no expiró, retorna response_json sin re-ejecutar la lógica.
/// TTL default 7 días. Cleanup por cron (FASE 5.B).
model IdempotencyKey {
  key          String   @id
  endpoint     String
  responseJson Json     @map("response_json")
  statusCode   Int      @map("status_code")
  userId       String?  @map("user_id")
  createdAt    DateTime @default(now()) @map("created_at")
  expiresAt    DateTime @map("expires_at")
  user         User?    @relation(fields: [userId], references: [id])

  @@index([expiresAt])
  @@map("idempotency_keys")
}

/// Sugerencia de compra automática (FASE 12.C). Generada por cron horario
/// que detecta stockables (insumos + productos direct_resale) con
/// `current_stock < threshold_min`. Polimórfico igual que InventoryMovement.
///
/// El cron deduplica: si ya hay una sugerencia PENDING/EVALUATED para la
/// misma entidad, no crea una nueva (evita ruido). Cuando el stock se
/// repone, las pendings pasan a STALE en el siguiente run.
///
/// 12.D agregará `llmRationale` + `llmModel` + `llmEvaluatedAt` populados
/// por un adapter LLM que evalúa cada sugerencia (precio razonable, qty
/// adecuada, alternativas).
model PurchaseSuggestion {
  id             String                   @id @default(uuid())
  /// Polimórfico: una de (ingredientId, productId) NOT NULL coherente con entityType.
  entityType     StockableType            @map("entity_type")
  ingredientId   String?                  @map("ingredient_id")
  productId      String?                  @map("product_id")
  /// Snapshot al momento de la sugerencia (auditable post-hoc).
  currentStock   Decimal                  @map("current_stock") @db.Decimal(14, 4)
  thresholdMin   Decimal                  @map("threshold_min") @db.Decimal(14, 4)
  unitPurchase   String                   @map("unit_purchase")
  /// Cantidad sugerida en unitPurchase. v1: refill a 2× threshold.
  suggestedQty   Decimal                  @map("suggested_qty") @db.Decimal(14, 4)
  /// Costo unitario estimado (último conocido). NULL si nunca se compró.
  estUnitCost    Decimal?                 @map("est_unit_cost") @db.Decimal(14, 4)
  /// Total estimado = suggestedQty × estUnitCost. NULL si no hay costo.
  estTotal       Decimal?                 @map("est_total") @db.Decimal(14, 2)
  /// Análisis LLM (12.D). NULL hasta que un evaluador lo procese.
  llmRationale   String?                  @map("llm_rationale")
  llmModel       String?                  @map("llm_model")
  llmEvaluatedAt DateTime?                @map("llm_evaluated_at")
  status         PurchaseSuggestionStatus @default(PENDING)
  resolvedById   String?                  @map("resolved_by")
  resolvedAt     DateTime?                @map("resolved_at")
  resolutionNote String?                  @map("resolution_note")
  createdAt      DateTime                 @default(now()) @map("created_at")
  ingredient     Ingredient?              @relation(fields: [ingredientId], references: [id], onDelete: Cascade)
  product        Product?                 @relation(fields: [productId], references: [id], onDelete: Cascade)
  resolvedBy     User?                    @relation(fields: [resolvedById], references: [id])

  @@index([status, createdAt(sort: Desc)])
  @@index([entityType, ingredientId, productId])
  @@map("purchase_suggestions")
}

/// PIN de aprobación de 6 dígitos para Admin Operativo / Dueño.
/// Usado por cajero para anular ventas, aplicar descuentos >15%,
/// abrir cajón sin venta. Header X-Approval-Pin: <pin>.
/// FASE 5: solo seed para Dueño (PIN configurable por env). UI para
/// cambiarlo entra en FASE 11.
///
/// CHECK: solo Admin/Dueño puede tener PIN (constraint en migration).
model ApprovalPin {
  userId    String   @id @map("user_id")
  pinHash   String   @map("pin_hash")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("approval_pins")
}

/// Reporte de reconciliación CSV (FASE 14.D). Persistencia del
/// resultado del módulo FASE 11.E para que el dueño tenga histórico
/// y pueda compararar imports a lo largo del tiempo. El detalle
/// (rows con status matched / unmatched_csv / unmatched_sale) va en
/// `report_json`.
model PaymentReconciliation {
  id              String   @id @default(uuid())
  source          String
  /// YYYY-MM-DD del primer txn detectado en el CSV.
  periodFrom      String   @map("period_from")
  /// YYYY-MM-DD del último txn detectado en el CSV.
  periodTo        String   @map("period_to")
  csvRowsParsed   Int      @map("csv_rows_parsed")
  posSalesEvaluated Int    @map("pos_sales_evaluated")
  matched         Int
  unmatchedCsv    Int      @map("unmatched_csv")
  unmatchedSale   Int      @map("unmatched_sale")
  /// Snapshot completo de ReconciliationReport (incluye filas).
  reportJson      Json     @map("report_json")
  importedById    String?  @map("imported_by_id")
  createdAt       DateTime @default(now()) @map("created_at")
  importedBy      User?    @relation(fields: [importedById], references: [id])

  @@index([createdAt(sort: Desc)])
  @@index([source, createdAt(sort: Desc)])
  @@map("payment_reconciliations")
}

/// Modalidad de pago del empleado.
enum PayType {
  MONTHLY
  DAILY
}

/// Día de pago de un trabajador DIARIO. Una fila = un día trabajado, con su
/// `amount` (por defecto el valor/día del usuario, editable: trabajó más / faltó
/// → se paga más/menos). La nómina de la quincena suma estos montos.
model PayrollDay {
  id          String   @id @default(uuid())
  userId      String   @map("user_id")
  workDate    DateTime @map("work_date") @db.Date
  amount      Decimal  @db.Decimal(12, 2)
  note        String?
  createdById String?  @map("created_by_id")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, workDate])
  @@index([userId, workDate(sort: Desc)])
  @@map("payroll_days")
}

/// Novedad de un PAGO (bono, regalo, horas extra, descuento). `periodStart`
/// identifica el inicio del pago: uno de {día 1, 8, 16, 23} del mismo mes
/// (4 pagos por mes = 2 quincenas × 2 sub-pagos). Se suma (o resta) al pago.
model PayrollAdjustment {
  id          String   @id @default(uuid())
  userId      String   @map("user_id")
  periodStart DateTime @map("period_start") @db.Date
  concept     String
  amount      Decimal  @db.Decimal(12, 2)
  note        String?
  createdById String?  @map("created_by_id")
  createdAt   DateTime @default(now()) @map("created_at")
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, periodStart])
  @@map("payroll_adjustments")
}

/// Control de pago: marca cada PAGO de cada trabajador como PAID (con
/// `proofImageKey` obligatoria = comprobante) o CANCELLED (motivo en `note`).
/// `amount` es snapshot del total al momento de marcar (sin auto-update).
/// Solo Dueño + PIN. Unique(userId, periodStart): un solo registro por par.
model PayrollPayment {
  id              String   @id @default(uuid())
  userId          String   @map("user_id")
  periodStart     DateTime @map("period_start") @db.Date
  /// 'PAID' | 'CANCELLED'
  status          String
  amount          Decimal  @db.Decimal(12, 2)
  resolvedAt      DateTime @map("resolved_at")
  actorId         String?  @map("actor_id")
  /// Bolsillo del que salió: 'EFECTIVO' | 'CUENTA' (legacy).
  paymentPocket   String   @default("CUENTA") @map("payment_pocket")
  /// Reparto del pago por bolsillo (permite mixto). Suman amount.
  cashAmount      Decimal  @default(0) @map("cash_amount") @db.Decimal(12, 2)
  bankAmount      Decimal  @default(0) @map("bank_amount") @db.Decimal(12, 2)
  /// Clave en storage del comprobante (obligatorio si status=PAID).
  proofImageKey   String?  @map("proof_image_key")
  /// Para CANCELLED, motivo; para PAID, nota opcional.
  note            String?
  createdAt       DateTime @default(now()) @map("created_at")
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, periodStart])
  @@index([periodStart])
  @@map("payroll_payments")
}

/// Log de notificaciones WhatsApp al cliente vía OpenWA (WS-2). Auditoría
/// + detalle de cada envío (status sent/failed). La idempotencia la dan
/// los flags notified_* en Sale; esta tabla guarda el historial.
model WhatsAppMessage {
  id                String   @id @default(uuid())
  saleId            String?  @map("sale_id")
  /// payment_instructions | payment_received | pickup_ready
  stage             String
  toPhone           String   @map("to_phone")
  body              String
  /// sent | failed
  status            String
  providerMessageId String?  @map("provider_message_id")
  error             String?
  createdAt         DateTime @default(now()) @map("created_at")
  sale              Sale?    @relation(fields: [saleId], references: [id], onDelete: SetNull)

  @@index([saleId, createdAt(sort: Desc)])
  @@index([status, createdAt(sort: Desc)])
  @@map("whatsapp_messages")
}

enum UserRole {
  CAJERO
  COCINERO
  ADMIN_OPERATIVO
  DUENO
  TRABAJADOR
}

enum InventoryMovementType {
  PURCHASE
  SALE
  MANUAL_ADJUSTMENT
  WASTE
  INITIAL
  /// Tanda de producción interna: +N a subproducto, -receta a insumos.
  /// Todos los movements de una misma producción comparten source_id.
  PRODUCTION
}

/// Discriminador para entidades stock-trackeables.
enum StockableType {
  INGREDIENT
  PRODUCT
  SUBPRODUCT
}

enum InvoiceStatus {
  PENDING_REVIEW
  CONFIRMED
  REJECTED
}

enum SaleType {
  COUNTER
  WEB_PICKUP
}

/// Estado del ciclo de vida de una venta (solo COUNTER + WEB_PICKUP).
/// Ciclo vigente (turnero/KDS eliminados, CLAUDE.md §7.v10):
///   COUNTER:     PENDIENTE_PAGO -> PAGADO (terminal).
///   WEB_PICKUP:  PENDIENTE_PAGO -> PAGADO -> LISTO_DESPACHO (terminal).
///   Cancelaciones: PENDIENTE_PAGO -> CANCELADO_NO_PAGO; cualquiera ->
///   CANCELADO_SIN_REEMBOLSO / VOID.
/// EN_PREPARACION y ENTREGADO quedan DORMIDOS (solo data histórica; ningún
/// código nuevo los escribe).
enum SaleStatus {
  PENDIENTE_PAGO
  PAGADO
  EN_PREPARACION
  LISTO_DESPACHO
  ENTREGADO
  CANCELADO_NO_PAGO
  CANCELADO_SIN_REEMBOLSO
  VOID
}

enum PaymentMethod {
  CASH
  NEQUI
  DAVIPLATA
  QR_BANCOLOMBIA
  TRANSFER
  CARD
}

enum ShiftStatus {
  OPEN
  CLOSED
  RECONCILED
}

enum CashMovementType {
  IN
  OUT
}

/// v1 solo usa PERCENT_OFF. El enum incluye los demás para no migrar
/// cuando se implementen en FASE 12.
enum PromotionType {
  PERCENT_OFF
  BOGO
  FIXED_OFF
  COMBO_OFF
}

/// Estado de una sugerencia de compra (FASE 12.C).
/// Flujo: PENDING (recién detectada) → EVALUATED (LLM analizó, 12.D) →
/// ACCEPTED / REJECTED por Dueño. STALE: la cron volvió a correr y el
/// stock se repuso por otra ruta (factura confirmada o adj manual) — la
/// sugerencia ya no es relevante.
enum PurchaseSuggestionStatus {
  PENDING
  EVALUATED
  ACCEPTED
  REJECTED
  STALE
}

/// Tipo de comisión (FASE 14.B). v1 implementa solo PERCENT_OF_SHIFT;
/// FIXED_PER_SALE queda como reserva para meseras.

/// Costo fijo del negocio (alquiler, servicios, software, contador, etc.).
/// MENSUAL = se cuenta tal cual en cada mes activo.
/// ANUAL = se prorratea ÷12 al mostrarse en un mes.
/// Vigencia opcional (started_at / ended_at) para subidas de precio o costos
/// que terminaron. La nómina NO se modela aquí — se jala automática del
/// módulo workers para no duplicar.
model FixedCost {
  id        String              @id @default(uuid())
  name      String
  amount    Decimal             @db.Decimal(14, 2)
  frequency FixedCostFrequency  @default(MONTHLY)
  category  String              @default("Otros")
  startedAt DateTime?           @map("started_at") @db.Date
  endedAt   DateTime?           @map("ended_at") @db.Date
  isActive  Boolean             @default(true) @map("is_active")
  notes     String?
  /// Responsable que asume este costo (ej. Cristian / Pablo). NULL = sin asignar.
  responsible String?
  createdAt DateTime            @default(now()) @map("created_at")
  updatedAt DateTime            @default(now()) @updatedAt @map("updated_at")
  payments  FixedCostPayment[]

  @@index([isActive])
  @@map("fixed_costs")
}

enum FixedCostFrequency {
  MONTHLY
  ANNUAL
  ONE_TIME
}

/// Tipo de medio de una pieza de publicidad del storefront web.
/// Fase 1 solo usa IMAGE; VIDEO queda reservado para la fase 2.
enum HeroMediaType {
  IMAGE
  VIDEO
}

/// Bolsillo de tesorería: efectivo en caja vs. plata en cuenta bancaria.
enum Pocket {
  EFECTIVO
  CUENTA
}

enum TreasuryMovementKind {
  TRANSFER
  ADJUSTMENT
}

enum TreasuryMovementStatus {
  ACTIVE
  VOIDED
}

enum PayableStatus {
  PENDING
  PAID
  CANCELLED
}

enum CortesiaStatus {
  PENDING
  APPROVED
  REJECTED
  REVERSED
}

/// Pagos efectivos de costos fijos. Un registro = un costo fijo × (año, mes).
/// Para MONTHLY hay un período por mes; para ANNUAL el módulo usa
/// period_month=1 por convención (el pago anual cubre todo el año).
/// `amount` es snapshot de lo realmente pagado (puede diferir del
/// `fixed_costs.amount` actual). `proof_image_key` es obligatorio.
model FixedCostPayment {
  id            String    @id @default(uuid())
  fixedCostId   String    @map("fixed_cost_id")
  periodYear    Int       @map("period_year")
  periodMonth   Int       @map("period_month")
  amount        Decimal   @db.Decimal(14, 2)
  paidAt        DateTime  @map("paid_at")
  proofImageKey String    @map("proof_image_key")
  actorId       String?   @map("actor_id")
  /// Bolsillo del que salió: 'EFECTIVO' | 'CUENTA' (legacy).
  paymentPocket String    @default("CUENTA") @map("payment_pocket")
  /// Reparto del pago por bolsillo (permite mixto). Suman amount.
  cashAmount    Decimal   @default(0) @map("cash_amount") @db.Decimal(14, 2)
  bankAmount    Decimal   @default(0) @map("bank_amount") @db.Decimal(14, 2)
  note          String?
  createdAt     DateTime  @default(now()) @map("created_at")
  fixedCost     FixedCost @relation(fields: [fixedCostId], references: [id], onDelete: Cascade)
  actor         User?     @relation("FixedCostPaymentActor", fields: [actorId], references: [id])

  @@unique([fixedCostId, periodYear, periodMonth])
  @@index([paidAt])
  @@map("fixed_cost_payments")
}

/// Conteo físico ciclado (control de inventario). Cada fila es un snapshot:
/// lo CONTADO físicamente vs lo que decía el ledger en ese momento. Si hay
/// diferencia, el service crea un MANUAL_ADJUSTMENT compensatorio
/// (source_type='stock_count', source_id=id) que corrige el ledger — el
/// conteo en sí nunca se edita (mismo espíritu insert-only que movements).
model StockCount {
  id           String        @id @default(uuid())
  entityType   StockableType @map("entity_type")
  ingredientId String?       @map("ingredient_id")
  productId    String?       @map("product_id")
  subproductId String?       @map("subproduct_id")
  countedQty   Decimal       @db.Decimal(14, 4) @map("counted_qty")
  ledgerQty    Decimal       @db.Decimal(14, 4) @map("ledger_qty")
  difference   Decimal       @db.Decimal(14, 4)
  /// Conteo del cocinero (#7): nace PENDING y NO ajusta stock hasta que el admin
  /// aprueba (recién ahí se materializa la diferencia). Los conteos del admin
  /// (o históricos) son APPROVED directo. Default APPROVED por eso.
  status       CountStatus   @default(APPROVED)
  resolvedById String?       @map("resolved_by_id")
  resolvedAt   DateTime?     @map("resolved_at")
  resolverNote String?       @map("resolver_note")
  userId       String?       @map("user_id")
  notes        String?
  createdAt    DateTime      @default(now()) @map("created_at")
  ingredient   Ingredient?   @relation(fields: [ingredientId], references: [id], onDelete: Restrict)
  product      Product?      @relation(fields: [productId], references: [id], onDelete: Restrict)
  subproduct   Subproduct?   @relation(fields: [subproductId], references: [id], onDelete: Restrict)
  user         User?         @relation(fields: [userId], references: [id])

  @@index([entityType, ingredientId, createdAt(sort: Desc)])
  @@index([entityType, productId, createdAt(sort: Desc)])
  @@index([entityType, subproductId, createdAt(sort: Desc)])
  @@index([status, createdAt(sort: Desc)])
  @@map("stock_counts")
}

enum CountStatus {
  PENDING
  APPROVED
  REJECTED
}

/// Pagos de una venta — fuente ÚNICA de verdad del método de pago. El cobro
/// simple escribe 1 fila; el dividido N (suma exacta = sales.total, validado
/// en SalesService.confirmPayment). `sales.payment_method` queda como resumen
/// denormalizado: el método si es único, NULL si la cuenta se dividió.
/// Caja, Z-report, reportes por método y reconciliación leen de acá.
model SalePayment {
  id             String        @id @default(uuid())
  saleId         String        @map("sale_id")
  method         PaymentMethod
  amount         Decimal       @db.Decimal(12, 2)
  /// Efectivo recibido para ESTA parte (>= amount → vuelto). Null en digital.
  amountReceived Decimal?      @db.Decimal(12, 2) @map("amount_received")
  createdAt      DateTime      @default(now()) @map("created_at")
  sale           Sale          @relation(fields: [saleId], references: [id], onDelete: Cascade)

  @@index([saleId])
  @@index([method, createdAt])
  @@map("sale_payments")
}

/// Qué métodos de pago están habilitados en el POS (los administra el admin).
/// El catálogo es el enum PaymentMethod; acá solo enabled + orden.
model PaymentMethodSetting {
  method    PaymentMethod @id
  enabled   Boolean       @default(false)
  sortOrder Int           @default(0) @map("sort_order")
  updatedAt DateTime      @default(now()) @updatedAt @map("updated_at")

  @@map("payment_method_settings")
}

/// Slides del B-roll del turnero — el dueño administra qué productos se muestran,
/// sus fotos y precios (antes hardcodeados en `broll-menu.ts`). La imagen vive
/// en storage (`imageKey`); se sirve por `GET /display/slide-image/:id` (público).
/// Si no hay ninguno activo, el turnero cae al menú por defecto (no se rompe).
model DisplaySlide {
  id          String   @id @default(uuid())
  name        String
  /// Categoría en la pastilla roja (eyebrow), ej. "Burgers".
  tag         String
  /// Precio en formato de vitrina, ej. "$29K". Texto libre, no es el precio real de venta.
  price       String
  description String
  imageKey    String   @map("image_key")
  imageMime   String   @map("image_mime")
  sortOrder   Int      @default(0) @map("sort_order")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at")

  @@index([isActive, sortOrder])
  @@map("display_slides")
}

/// Pistas de música ambiente del turnero — el dueño sube/administra los tracks.
/// El audio vive en storage (`audioKey`); se sirve por `GET /display/track-audio/:id`.
model DisplayTrack {
  id        String   @id @default(uuid())
  label     String
  audioKey  String   @map("audio_key")
  audioMime String   @map("audio_mime")
  sortOrder Int      @default(0) @map("sort_order")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([isActive, sortOrder])
  @@map("display_tracks")
}

/// Piezas de publicidad del storefront web (encima del menú) — el dueño las
/// administra desde `/publicidad`. El medio vive en storage (`mediaKey`); se
/// sirve por `GET /web-hero/media/:id` (público). `linkUrl` es a dónde lleva al
/// tocar (interno o externo); null = no clickeable. Si no hay ninguno activo,
/// la web cae a su hero estático (no se rompe). Fase 1 solo IMAGE.
model WebHeroSlide {
  id        String        @id @default(uuid())
  mediaType HeroMediaType @default(IMAGE) @map("media_type")
  mediaKey  String        @map("media_key")
  mediaMime String        @map("media_mime")
  linkUrl   String?       @map("link_url")
  sortOrder Int           @default(0) @map("sort_order")
  isActive  Boolean       @default(true) @map("is_active")
  createdAt DateTime      @default(now()) @map("created_at")
  updatedAt DateTime      @default(now()) @updatedAt @map("updated_at")

  @@index([isActive, sortOrder])
  @@map("web_hero_slides")
}

/// Pago semanal de nómina para empleados DIARIO (v6). A diferencia de
/// `PayrollPayment` (quincenal, todo-o-nada), acá hay VARIAS filas por
/// (empleado, semana): cada abono parcial cubre los `paidDays` que se pagan en
/// ese momento, con comprobante obligatorio. La semana es lunes–domingo
/// (`weekStart` = lunes). Si el pago es en efectivo, genera un CashMovement OUT
/// en la caja abierta (`cashMovementId`/`shiftId`) para que el arqueo cuadre.
model PayrollWeekPayment {
  id             String   @id @default(uuid())
  userId         String   @map("user_id")
  weekStart      DateTime @map("week_start") @db.Date
  /// Días cubiertos por este abono (YYYY-MM-DD[]).
  paidDays       Json     @map("paid_days")
  amount         Decimal  @db.Decimal(12, 2)
  /// Forma de pago por bolsillo: cashAmount + bankAmount = amount. Permite
  /// pago mixto (parte efectivo, parte cuenta). El método digital puntual ya
  /// no importa para tesorería (solo efectivo vs cuenta).
  cashAmount     Decimal  @default(0) @map("cash_amount") @db.Decimal(12, 2)
  bankAmount     Decimal  @default(0) @map("bank_amount") @db.Decimal(12, 2)
  /// Legacy (nullable): método único previo. Hoy se usa cashAmount/bankAmount.
  method         String?
  /// 'PAID' | 'VOIDED'.
  status         String   @default("PAID")
  proofImageKey  String   @map("proof_image_key")
  actorId        String?  @map("actor_id")
  /// Movimiento de caja generado por la porción en efectivo (para revertir).
  cashMovementId String?  @map("cash_movement_id")
  shiftId        String?  @map("shift_id")
  note           String?
  paidAt         DateTime @map("paid_at")
  createdAt      DateTime @default(now()) @map("created_at")
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, weekStart])
  @@index([weekStart])
  @@map("payroll_week_payments")
}

/// Compromiso / cuenta por pagar a una persona (Cristian, Pablo u otro). Es la
/// versión ad-hoc de los "gastos pendientes" del Excel: lo que el negocio le
/// debe a alguien, fuera de facturas/costos fijos/nómina. Al pagarlo se reparte
/// por bolsillo (efectivo/cuenta/mixto) y alimenta la Tesorería.
model PayableCommitment {
  id            String    @id @default(uuid())
  /// A quién se le debe (texto libre: Cristian, Pablo, …).
  beneficiary   String
  description   String
  amount        Decimal       @db.Decimal(14, 2)
  status        PayableStatus @default(PENDING)
  cashAmount    Decimal       @default(0) @map("cash_amount") @db.Decimal(14, 2)
  bankAmount    Decimal   @default(0) @map("bank_amount") @db.Decimal(14, 2)
  proofImageKey String?   @map("proof_image_key")
  paidAt        DateTime? @map("paid_at")
  actorId       String?   @map("actor_id")
  createdById   String?   @map("created_by_id")
  note          String?
  createdAt     DateTime  @default(now()) @map("created_at")

  @@index([status])
  @@map("payable_commitments")
}

model CortesiaRequest {
  id            String         @id @default(uuid())
  status        CortesiaStatus @default(PENDING)
  /// Pedido que acompañó la cortesía (contexto); null si fue un regalo suelto.
  saleId        String?   @map("sale_id")
  productId     String    @map("product_id")
  sizeId        String?   @map("size_id")
  quantity      Int
  reason        String
  /// COGS snapshot (costo real estimado del producto regalado).
  costAmount    Decimal?  @map("cost_amount") @db.Decimal(14, 2)
  /// Precio de venta de referencia (lo que se habría cobrado).
  salePrice     Decimal   @map("sale_price") @db.Decimal(14, 2)
  requestedById String    @map("requested_by_id")
  resolvedById  String?   @map("resolved_by_id")
  resolvedAt    DateTime? @map("resolved_at")
  resolverNote  String?   @map("resolver_note")
  /// El cajero ya vio el resultado (acusa una cortesía "Observada").
  seenByRequester Boolean @default(false) @map("seen_by_requester")
  createdAt     DateTime  @default(now()) @map("created_at")

  @@index([status, createdAt])
  @@map("cortesia_requests")
}

/// Tesorería — saldos iniciales de los dos bolsillos (Efectivo y Cuenta) y la
/// fecha de corte desde la que se cuenta. Fila única "singleton" (las "celdas
/// amarillas" del Excel). Si `anchorDate` es NULL se cuenta todo el histórico.
model TreasuryConfig {
  id          String    @id @default("singleton")
  anchorDate  DateTime? @map("anchor_date") @db.Date
  initialCash Decimal   @default(0) @map("initial_cash") @db.Decimal(14, 2)
  initialBank Decimal   @default(0) @map("initial_bank") @db.Decimal(14, 2)
  updatedAt   DateTime  @default(now()) @updatedAt @map("updated_at")

  @@map("treasury_config")
}

/// Movimiento manual de tesorería: TRANSFER = traspaso entre bolsillos (no
/// cambia el total), ADJUSTMENT = ajuste de un bolsillo (±, para el "híbrido").
/// Insert-only conceptual; se anula creando el compensatorio (status VOIDED).
model TreasuryMovement {
  id         String                 @id @default(uuid())
  kind       TreasuryMovementKind
  /// TRANSFER: bolsillo origen.
  fromPocket Pocket?                @map("from_pocket")
  /// TRANSFER: bolsillo destino.
  toPocket   Pocket?                @map("to_pocket")
  /// ADJUSTMENT: bolsillo afectado.
  pocket     Pocket?
  /// TRANSFER: monto positivo. ADJUSTMENT: con signo (+ suma, − resta).
  amount     Decimal                @db.Decimal(14, 2)
  reason     String
  status     TreasuryMovementStatus @default(ACTIVE)
  actorId    String?                @map("actor_id")
  occurredAt DateTime @map("occurred_at")
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([occurredAt])
  @@map("treasury_movements")
}

/// Config global del negocio (fila única, id fijo "singleton"). `monthStartDay`
/// (1–28) define el día en que arranca el "mes del negocio" para el estado
/// financiero: ej. 25 = el mes va del 25 al 24 del mes siguiente. 1 = mes
/// calendario (comportamiento por defecto).
model BusinessConfig {
  id            String   @id @default("singleton")
  monthStartDay Int      @default(1) @map("month_start_day")
  /// Kill-switch de pedidos web (#13): false = POST /web/orders rechazado y
  /// la web oculta el checkout. El dueño lo apaga ante abuso, sin deploy.
  webOrdersEnabled Boolean @default(true) @map("web_orders_enabled")
  updatedAt     DateTime @default(now()) @updatedAt @map("updated_at")

  @@map("business_config")
}

// ====================================================================
// COCINA (app del cocinero) — incidencias + checklist apertura/cierre
// ====================================================================

enum KitchenIncidentCategory {
  INSUMO
  EQUIPO
  PRODUCCION
  OTRO
}

enum ChecklistType {
  OPEN
  CLOSE
}

/// Bitácora de incidencias que el cocinero deja para el dueño (insumo en mal
/// estado, equipo, tanda perdida…). FK a usuario relation-less (se resuelve el
/// nombre en el service), igual que treasury_movements.actorId.
model KitchenIncident {
  id           String                  @id @default(uuid())
  category     KitchenIncidentCategory
  note         String
  authorId     String                  @map("author_id")
  resolvedAt   DateTime?               @map("resolved_at")
  resolvedById String?                 @map("resolved_by_id")
  createdAt    DateTime                @default(now()) @map("created_at")

  @@index([createdAt(sort: Desc)])
  @@index([resolvedAt])
  @@map("kitchen_incidents")
}

/// Ítem del checklist de apertura/cierre de cocina (lo administra el admin/dueño).
model ChecklistItem {
  id        String        @id @default(uuid())
  type      ChecklistType
  label     String
  sortOrder Int           @default(0) @map("sort_order")
  isActive  Boolean       @default(true) @map("is_active")
  createdAt DateTime      @default(now()) @map("created_at")

  @@index([type, isActive, sortOrder])
  @@map("checklist_items")
}

/// Una rutina de checklist (apertura/cierre) completada en un día de negocio.
/// `day` = YYYY-MM-DD local. Único por (type, day): la rutina se cierra una vez
/// al día (re-completar hace upsert).
model ChecklistCompletion {
  id            String        @id @default(uuid())
  type          ChecklistType
  day           String
  doneItemIds   String[]      @map("done_item_ids")
  completedById String        @map("completed_by_id")
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @default(now()) @updatedAt @map("updated_at")

  @@unique([type, day])
  @@map("checklist_completions")
}
