# Print Agent — copiarlo a `.env` en la PC donde está la impresora.

# Puerto local del agent (el navegador del POS le pega acá).
PRINT_AGENT_PORT=9120

# (opcional) secreto compartido; si se configura, el POS debe mandar X-Agent-Secret.
# Solo sirve para el camino SERVIDOR→agent: el navegador de la caja llama sin
# credencial, y de ese lado la barrera es el ORIGEN (abajo).
# PRINT_AGENT_SECRET=

# (opcional) pantallas del negocio que pueden imprimir y abrir el cajón, además
# de las que ya vienen en el código (admin.tercos.co, el deploy de QA) y de
# cualquier localhost. Se SUMAN, no reemplazan. Separadas por coma.
# Solo hace falta si sirves la caja desde otro dominio: si el mostrador deja de
# imprimir, el log del agent dice qué origen rechazó y qué poner acá.
# PRINT_AGENT_ALLOWED_ORIGINS=https://otrodominio.co

# VÁLVULA DE ESCAPE — vuelve al comportamiento viejo: cualquier página web que
# abra el cajero puede imprimir y abrir el cajón. Es para desatascar el
# mostrador en el momento, no para dejarla puesta.
# PRINT_AGENT_ALLOW_ANY_ORIGIN=1

# ── WINDOWS (recomendado en el mostrador) ─────────────────────────────
# Nombre EXACTO de la impresora instalada en Windows (imprime RAW por el
# spooler, sin Zadig, sin drivers raros). Verlo con:  Get-Printer | Select Name
# PRINTER_NAME=POS58 Printer

# ── macOS / Linux (USB directo, libusb) ───────────────────────────────
# IDs USB de la impresora. Obtenerlos con:  pnpm -F @pos-tercos/print-agent list-usb
# PRINTER_USB_VENDOR_ID=0x0416
# PRINTER_USB_PRODUCT_ID=0x5011

# ── Linux / Raspberry Pi (device file) ────────────────────────────────
# PRINTER_DEVICE=/dev/usb/lp0

# ── Negocio en el recibo OFFLINE ──────────────────────────────────────
# Solo se usan cuando el POS imprime SIN backend (offline): el agent rinde
# el recibo y toma estos datos. Online, el negocio lo pone el backend.
# Si se dejan vacíos, el agent usa los mismos defaults que el backend.
# Conviene que coincidan con los del backend (Railway).
# BUSINESS_NAME=Tercos Burgers
# BUSINESS_ADDRESS=Cra 1 #2-3, Ciudad
# BUSINESS_NIT=900.000.000-0
# BUSINESS_PHONE=+57 300 0000000
